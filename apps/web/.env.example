# OpenAI
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# AI Gateway (required for non-OpenAI models like anthropic/...)
AI_GATEWAY_API_KEY=

# Model used for UI generation/chat
# Supports provider-prefixed model ids (example: anthropic/claude-haiku-4.5)
MODEL=anthropic/claude-haiku-4.5

# Vercel KV (Rate Limiting)
# Automatically populated when you add Vercel KV to your project
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Rate Limiting
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100
