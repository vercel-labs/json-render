---
import { renderToHtml } from "@json-render/astro";
import { registry } from "../lib/registry";
import { demoSpec } from "../lib/spec";

const html = renderToHtml(demoSpec, {
  registry,
  state: { showBanner: true, userRole: "admin" },
});
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@json-render/astro demo</title>
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #f9fafb;
        color: #111827;
        min-height: 100vh;
        padding: 24px;
      }
      section {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 640px;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <div set:html={html} />
  </body>
</html>
