{
  "name": "@json-render/gsplat",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Gaussian Splatting renderer for @json-render/core. JSON becomes 3D gaussian splats.",
  "keywords": [
    "json",
    "3d",
    "gaussian-splatting",
    "gsplat",
    "point-cloud",
    "photogrammetry",
    "webgl",
    "ai",
    "generative-ui",
    "llm",
    "renderer",
    "streaming",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/json-render.git",
    "directory": "packages/gsplat"
  },
  "homepage": "https://json-render.dev",
  "bugs": {
    "url": "https://github.com/vercel-labs/json-render/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.mjs",
      "require": "./dist/catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@json-render/core": "workspace:*",
    "@json-render/react": "workspace:*",
    "gsplat": "^1.2.9"
  },
  "devDependencies": {
    "@internal/typescript-config": "workspace:*",
    "@types/react": "19.2.3",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  }
}
